# --- Solana (devnet) ---
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_PROGRAM_ID=H6Ue9aCKtRKbGM2gBH2obMeCqBniCsSkgV5QoPFLL6XF
# Prize token. Run `npm run setup:devnet` to create a free test-USDC mint you control.
NEXT_PUBLIC_PRIZE_MINT=
NEXT_PUBLIC_PRIZE_DECIMALS=6
NEXT_PUBLIC_PRIZE_SYMBOL=USDC
# Base58 secret key of the test mint authority (server only, devnet only). Powers the faucet.
FAUCET_SECRET_KEY=

# --- AI quiz generation (any one; without a key GeeClass uses its built-in offline generator) ---
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=

# --- Voice host (optional; falls back to the browser's built-in voice) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# --- Storage (optional; in-memory by default, use Supabase for serverless hosting) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Set to 1 only for local UI testing without devnet access.
SKIP_CHAIN_VERIFY=0
